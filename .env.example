# Copy to .env.local. Never commit real values.
# Browser-safe (Supabase "anon"/publishable key; RLS protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel env vars). Used by api/care-review.ts
SUPABASE_URL=
SUPABASE_ANON_KEY=
# AI for the weekly summary (server-only; set in Vercel, never in the browser or the repo).
# Set ONE provider. If both are set, Anthropic is used. Neither = template summary, labeled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
# Required with OPENAI_API_KEY: the model name exactly as listed in your OpenAI account
